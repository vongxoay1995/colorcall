<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".paywall.PayWallActivity">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lotie_hand"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="W,1.28:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/paywall" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ic_close"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:padding="@dimen/_5sdp"
        android:src="@drawable/ic_close_iap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/_25sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:adjustViewBounds="true"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_iap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.6"
        android:background="@drawable/bg_white_radius_top"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ready_to_go_pro"
                android:textColor="@color/black"
                android:textSize="@dimen/_19sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/content1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/free_trial_for_3_days_no_payment_now"
                android:textColor="#848484"
                android:textSize="@dimen/_12sdp"
                android:paddingHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                android:layout_marginTop="@dimen/_5sdp"/>
            <LinearLayout
                android:id="@+id/layoutDesIap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/bg_round_iap"
                android:padding="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@id/content1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/ic_diamond"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:text="@string/no_more_annoying_ads_unlock_all_theme_amp_get_supported_24_7"
                    android:textColor="#171C2C"
                    android:textSize="@dimen/_12sdp"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/layoutToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/layoutDesIap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/bg_round_stroke_iap"
                android:padding="@dimen/_15sdp">

                <TextView
                    android:id="@+id/tvToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/free_trial_enabled"
                    android:textSize="@dimen/_13sdp"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/sw_enable_trial"
                    android:layout_centerVertical="true"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_enable_trial"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumb="@drawable/custom_thump_switch"
                    android:layout_alignParentEnd="true"
                    app:track="@drawable/custom_track_switch" />
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/content3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/free_for_first_3_days_then_s_week"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:gravity="center"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutToggle"
                android:layout_marginTop="@dimen/_10sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtdesPack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_renew_cancel_anytime"
                android:textColor="#171C2C"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/content3"
                android:textSize="@dimen/_12sdp"/>
            <RelativeLayout
                android:id="@+id/layoutBuyNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/txtdesPack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/bg_button_buy_iap"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:paddingVertical="@dimen/_15sdp">

                <TextView
                    android:id="@+id/txtBuyNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:text="@string/start_3_days"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:textSize="@dimen/_15sdp" />
            </RelativeLayout>
            <TextView
                android:id="@+id/terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/term_paywall"
                android:textSize="@dimen/_10sdp"
                android:fontFamily="@font/roboto_light"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/layoutBuyNow"
                android:textColor="#bababa"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        android:visibility="gone"
        android:background="@drawable/bg_white_radius_top"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/layoutLoading">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>