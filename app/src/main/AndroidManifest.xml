        <receiver
            android:name=".dialer.CallActionReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.simplemobiletools.dialer.action.ACCEPT_CALL" />
                <action android:name="com.simplemobiletools.dialer.action.DECLINE_CALL" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".dialer.activity.CallOwnerActivity"
            android:exported="true"
            android:icon="@drawable/ic_dialer_circle"
            android:label="@string/color_call_dialer"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>